{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ping-service",
  "compatibility_date": "2026-08-27",
  "main": "./dist/worker.js",
  "workers_dev": true,
  "upload_source_maps": true,
  "no_bundle": true,
  "observability": {
    "enabled": true,
  },
  "triggers": {
    "crons": ["0 * * * *"], // every hour
  },
  "secrets_store_secrets": [
    {
      "binding": "BUGBOX_API_KEY",
      "secret_name": "PING_SERVICE_BUGBOX_API_KEY",
      "store_id": "04d5e57002004507b878be996e770b48",
    },
    {
      "binding": "BUGBOX_REFERRER",
      "secret_name": "PING_SERVICE_BUGBOX_REFERRER",
      "store_id": "04d5e57002004507b878be996e770b48",
    },
  ],
  "send_metrics": false,
}
